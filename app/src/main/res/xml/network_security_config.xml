<?xml version="1.0" encoding="utf-8"?>
<!-- ISO 27400: solo conexiones cifradas. Se rechaza cualquier trafico HTTP sin TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
